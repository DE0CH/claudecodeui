{
  // The browser UI is the Paseo app under paseo/ (its own tsconfig); this file only covers shared/ for the editor and
  // the lint resolver. The server has server/tsconfig.json.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["shared"]
}
